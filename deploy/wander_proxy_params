# En-têtes transmis à l'application. X-Real-IP / X-Forwarded-For sont ÉCRASÉS
# par l'IP réelle du client (jamais repris de la requête) : la limitation des
# tentatives ne peut pas être contournée en falsifiant ces en-têtes.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header Connection "";
proxy_read_timeout 60s;
