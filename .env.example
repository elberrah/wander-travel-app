# ─── Wander : authentification ─────────────────────────────────────────────
# Copiez ce fichier en .env.local (développement) ou /etc/wander/wander.env
# (serveur). Ne commitez JAMAIS les vraies valeurs.

# Secret de signature des sessions (32+ caractères aléatoires) :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Adresse publique du site (sans / final). Sur Vercel : déduite automatiquement si vide.
BETTER_AUTH_URL=http://localhost:3000
# Autres origines autorisées, séparées par des virgules (ex. le domaine www)
BETTER_AUTH_TRUSTED_ORIGINS=

# Base de données
# - VPS : SQLite, fichier local (défaut ./data/wander.db)
DATABASE_PATH=
# - Vercel : Postgres (Neon via Vercel > Storage, variable injectée automatiquement)
DATABASE_URL=

# Comptes promus administrateur automatiquement (une fois l'email vérifié)
ADMIN_EMAILS=contact@wandertravel-event.com

# ─── Google OAuth 2.0 (console.cloud.google.com > Identifiants) ───────────
# URI de redirection autorisée :
#   https://wandertravel-event.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (développement)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Envoi des emails (confirmation, mot de passe oublié) ─────────────────
# Sans SMTP en développement, les liens s'affichent dans le terminal.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wander Travel & Event <contact@wandertravel-event.com>"

# Limitation des tentatives (toujours active en production)
AUTH_RATE_LIMIT=false
