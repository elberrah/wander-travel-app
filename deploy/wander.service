[Unit]
Description=Wander Travel & Event (Next.js + authentification)
After=network.target

[Service]
Type=simple
User=wander
Group=wander
WorkingDirectory=/var/www/wandertravel-event.com/app
EnvironmentFile=/etc/wander/wander.env
Environment=NODE_ENV=production
Environment=PORT=3000
# Écoute locale uniquement : seul Nginx peut joindre l'application.
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wander
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
